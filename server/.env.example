# --- Core ---
PORT=3000
NODE_ENV=development
# Leave empty in development to use an in-memory MongoDB (data is lost on restart).
MONGODB_URI=
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the Angular app (used for CORS and for links in emails).
CLIENT_URL=http://localhost:4200
# Cookie SameSite policy: lax (default; client proxies /api same-origin) or none (cross-site API).
COOKIE_SAMESITE=lax
# Allow joining without email verification (ignored when NODE_ENV=production).
DEV_INSTANT_JOIN=true
# Seed the demo group on start-up when using the in-memory database (development only).
SEED_DEMO=true

# --- Cloudinary (images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for uploads inside your Cloudinary account.
CLOUDINARY_FOLDER=secret-santa

# --- Email ---
# Pick ONE provider. With none set, emails (incl. magic links) are logged to the console.
# On Render's free tier outbound SMTP ports are blocked, so use an HTTPS API (Brevo or Resend).
# Brevo: free 300/day, no own domain needed (verify your sender address in Brevo).
BREVO_API_KEY=
# Resend: needs a verified domain; MAIL_FROM must use that domain.
RESEND_API_KEY=
# Classic SMTP (fine locally or on paid hosts):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Secret Santa <santa@example.com>"

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Jobs ---
# Delete group data this many days after the exchange date.
DATA_RETENTION_DAYS=60
# Cron expression for the daily job (server time, UTC on Render).
DAILY_JOB_CRON=0 8 * * *
# Production only: URL pinged every 10 min so the free Render instance never sleeps.
# Defaults to RENDER_EXTERNAL_URL (set by Render). Use "off" to disable.
KEEP_ALIVE_URL=
